#!/usr/bin/env python3
"""browser-picker-apps — local desktop app & web app web-URL handlers for browser-picker.

Discovers:
  1. Installed native desktop apps that register custom URI schemes (x-scheme-handler/*)
     and maps their well-known web URLs to deep links (e.g. T3 Code, Spotify, Zoom,
     Slack, Telegram, Discord, Linear, Notion, Figma, Steam, Signal, Matrix).
  2. Installed Omarchy / Chromium-family web apps (.desktop entries using
     `omarchy-launch-webapp` or `--app=https://...`).
  3. User-configured entries in `~/.config/browser-picker/apps.conf`.

Pure Python 3 stdlib, GUI-free, and importable so unit tests run without GTK or a display.

CLI:
  browser-picker-apps match --url URL
      Print matching apps as "label\\tkind\\ttarget" (one per line).
  browser-picker-apps list [--detail]
      Print all available app labels (or "label\\tkind\\tsource" with --detail).
  browser-picker-apps can-handle --label LABEL --url URL
      Exit 0 if LABEL handles URL, 2 if LABEL is a known app that cannot handle URL, 1 if unknown.
  browser-picker-apps is-app --label LABEL
      Exit 0 if LABEL is a known app, 1 otherwise.
  browser-picker-apps launch --label LABEL --url URL [--dry-run]
      Launch LABEL for URL detached (or print JSON argv with --dry-run).
      Exit codes: 0 launched, 2 known app cannot handle URL, 1 unknown label / launch failed.
"""
import fnmatch
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import urllib.parse

