#!/usr/bin/env python3
"""Launch Browser Picker for one Chromium native-messaging request."""

import json
import os
import shutil
import struct
import subprocess
import sys
from pathlib import Path
from urllib.parse import urlsplit

HEADER = struct.Struct("=I")
MAX_MESSAGE_BYTES = 1024 * 1024


def read_url(stream):
    (length,) = HEADER.unpack(stream.read(HEADER.size))
    if not 0 < length <= MAX_MESSAGE_BYTES:
        return None
    data = stream.read(length)
    if len(data) != length:
        return None
    message = json.loads(data.decode("utf-8"))
    # A previous extension version also sent diagnostic messages with act=false.
    url = message.get("url") if isinstance(message, dict) and message.get("act", True) is True else None
    if not isinstance(url, str) or any(ord(char) < 32 or ord(char) == 127 for char in url):
        return None
    parsed = urlsplit(url)
    if parsed.scheme in ("http", "https") and parsed.hostname:
        return url
    return None


def launch(url):
    picker = (
        shutil.which("browser-picker")
        or shutil.which(Path(__file__).resolve().with_name("browser-picker"))
        or shutil.which(Path.home() / ".local/bin/browser-picker")
    )
    if not picker:
        raise FileNotFoundError("browser-picker")
    subprocess.Popen(
        [os.fspath(picker), url],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def main():
    ok = False
    try:
        url = read_url(sys.stdin.buffer)
        if url:
            launch(url)
            ok = True
    except (OSError, ValueError, struct.error):
        print("Browser Picker bridge could not hand off the link", file=sys.stderr)

    reply = b'{"ok":true}' if ok else b'{"ok":false}'
    sys.stdout.buffer.write(HEADER.pack(len(reply)) + reply)
    sys.stdout.buffer.flush()


if __name__ == "__main__":
    main()
