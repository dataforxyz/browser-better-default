#!/bin/bash
# browser-picker — pick a browser + profile when opening a link, with smart-default rules.
# Default http/https/mailto handler (browser-picker.desktop).
# Config (edit via Browser Better Default, the in-menu "Create a rule" action, or by hand):
#   ~/.config/browser-picker/browsers.conf   browser+profile entries
#   ~/.config/browser-picker/rules.conf      smart-default rules

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/browser-picker"
RULESFILE="$CONF/rules.conf"
PRIV_SUFFIX="  🕶 Private"

resolve() {  # label -> command string (looks in ENTRIES)
  local label="$1" e
  for e in "${ENTRIES[@]}"; do
    [ "${e%%|||*}" = "$label" ] && { printf '%s' "${e#*|||}"; return 0; }
  done
  return 1
}

launch() {  # <command-string> <urls...> -> run detached
  local cmd="$1"; shift
  eval "setsid -f $cmd \"\$@\"" >/dev/null 2>&1
}

private_flag() {  # command-string -> private/incognito flag for that browser family
  case "$1" in
    *zen-browser*|*firefox*|*librewolf*|*waterfox*) printf -- '--private-window' ;;
    *) printf -- '--incognito' ;;  # chromium / brave / chrome / edge
  esac
}

# matches <pattern> <url> -> 0 if the URL matches. Modes:
#   regex:RE    -> bash regex
#   has * or ?  -> glob over whole URL
#   ends with / -> prefix match (URL contains the pattern)
#   otherwise   -> substring on BOTH path/host boundaries (start-or-[/:] on the left,
#                  end-or-[/?#:] on the right) so "github.com/org/repo" matches that repo
#                  and its children, but not "…/repo-staging" nor "notgithub.com".
matches() {
  local pat="$1" url="$2"
  # shellcheck disable=SC2053  # the *[*?]* branch intentionally leaves $pat unquoted to glob-match
  case "$pat" in
    regex:*) [[ "$url" =~ ${pat#regex:} ]] ;;
    *[*?]*)  [[ "$url" == $pat ]] ;;
    */)      [[ "$url" == *"$pat"* ]] ;;
    *)       [[ "$url" == "$pat" || "$url" == "$pat"[/?\#:]* \
              || "$url" == *[/:]"$pat" || "$url" == *[/:]"$pat"[/?\#:]* ]] ;;
  esac
}

menu_prompt() {  # URL -> concise prompt; strips query/fragment so tokens don't sit in the menu title
  local u="$1"
  if [ -z "$u" ]; then
    printf 'Open link in…'
    return
  fi
  u="${u%%#*}"
  u="${u%%\?*}"
  if [ "${#u}" -gt 90 ]; then
    u="${u:0:87}…"
  fi
  printf 'Open %s in…' "$u"
}

menu() {  # prompt on $1, options on stdin -> selected line on stdout
  local prompt="$1"
  if [ -n "${BROWSER_PICKER_MENU:-}" ]; then
    BROWSER_PICKER_PROMPT="$prompt" sh -c "$BROWSER_PICKER_MENU"
  elif [ -n "${native_menu:-}" ]; then
    BROWSER_PICKER_PROMPT="$prompt" "$native_menu"
  elif command -v omarchy-launch-walker >/dev/null 2>&1; then
    omarchy-launch-walker --dmenu --width 380 --minheight 1 --maxheight 500 -p "$prompt" 2>/dev/null
  else
    walker --dmenu --width 380 -p "$prompt" 2>/dev/null
  fi
}

unique_menu_item() {
  local item="$1" hint="$2"
  while printf '%s\n' "${MENU_ITEMS[@]}" | grep -Fxq -- "$item"; do
    item="$item ($hint)"
  done
  printf '%s' "$item"
}

entry_labels() { local e; for e in "${ENTRIES[@]}"; do printf '%s\n' "${e%%|||*}"; done; }
entry_private_labels() { local e; for e in "${ENTRIES[@]}"; do printf '%s\n' "${e%%|||*}$PRIV_SUFFIX"; done; }

notify() { command -v notify-send >/dev/null 2>&1 && notify-send "Browser Picker" "$1"; }

helper_bin() {  # name -> sibling next to this script, or executable on PATH
  local name="$1" here
  here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  [ -x "$here/$name" ] && { printf '%s' "$here/$name"; return 0; }
  if command -v "$name" >/dev/null 2>&1; then
    command -v "$name"
    return 0
  fi
  return 1
}

open_remaining_urls() {  # remaining URLs after $1 was handled by a single-URL local app
  local extra
  for extra in "$@"; do
    ( main "$extra" )
  done
}

have_recommender() { helper_bin browser-picker-recommend >/dev/null 2>&1; }

is_matched_app() {
  local label="$1" a
  for a in "${APP_LABELS[@]}"; do
    [ "$a" = "$label" ] && return 0
  done
  return 1
}

rescan_profiles() {
  local prof_bin
  [ "${BROWSER_PICKER_AUTO_RESCAN:-1}" = "0" ] && return 0
  prof_bin="$(helper_bin browser-picker-profiles)" || return 0
  "$prof_bin" rescan --quiet >/dev/null 2>&1 || true
}

main() {
  rescan_profiles
  mapfile -t ENTRIES < <(grep -vE '^\s*(#|$)' "$CONF/browsers.conf" 2>/dev/null)
  mapfile -t RULES   < <(grep -vE '^\s*(#|$)' "$RULESFILE"          2>/dev/null)
  local url="${1:-}" r en rest pat lbl rpriv cmd choice target i l smart_out
  local apps_bin="" rec_bin="" app_rc=0 app_lbl="" app_kind="" _app_target=""
  local sug_pattern="" sug_label="" sug_priv="0" sug_item="" _sug_scope=""
  local app_pattern="" app_scope=""
  local native_menu="" menu_status=0 editor_bin="" private_item=""
  local REMEMBER_LABEL="📌  Create a rule for links like this…" EDIT_LABEL="⚙  Edit rules…"
  local -a SMART=() SUG_PATTERNS=() SUG_LABELS=() SUG_PRIVS=() SUG_ITEMS=()
  local -a MENU_ITEMS=() PRIVATE_ITEMS=() PRIVATE_TARGETS=()
  local -a APP_LABELS=() NATIVE_APP_LABELS=() WEBAPP_LABELS=() APP_ORDER_ARGS=()

  apps_bin="$(helper_bin browser-picker-apps 2>/dev/null || true)"
  rec_bin="$(helper_bin browser-picker-recommend 2>/dev/null || true)"

  # 1) Smart defaults: first enabled, matching rule wins — skips the menu.
  if [ -n "$url" ]; then
    for r in "${RULES[@]}"; do
      en="${r%%|||*}"; rest="${r#*|||}"
      pat="${rest%%|||*}"; rest="${rest#*|||}"
      lbl="${rest%%|||*}"
      rpriv=0; [ "$rest" != "$lbl" ] && rpriv="${rest#*|||}"   # optional 4th field: private
      [ "$en" = "1" ] || continue
      [ -z "$pat" ] && continue
      matches "$pat" "$url" || continue
      if cmd="$(resolve "$lbl")"; then
        if [ "$rpriv" = "1" ]; then launch "$cmd $(private_flag "$cmd")" "$@"; else launch "$cmd" "$@"; fi
        return 0
      fi
      if [ "$rpriv" != "1" ] && [ -n "$apps_bin" ]; then
        app_rc=0
        "$apps_bin" launch --label "$lbl" --url "$url" >/dev/null 2>&1 || app_rc=$?
        if [ "$app_rc" -eq 0 ]; then
          [ "$#" -gt 1 ] && { shift; open_remaining_urls "$@"; }
          return 0
        elif [ "$app_rc" -eq 2 ]; then
          # Known (or disabled) local app, but this specific URL isn't openable in it -> try later rules / picker.
          continue
        fi
      fi
      break   # rule names an unknown label (or private rule on non-browser) -> fall through to the picker
    done
  fi

  # 2) Show the picker.
  if [ -z "${BROWSER_PICKER_MENU:-}" ] && command -v omarchy-menu-select >/dev/null 2>&1; then
    if [ -n "${BROWSER_PICKER_MENU_SELECT:-}" ]; then
      local BROWSER_PICKER_MENU="$BROWSER_PICKER_MENU_SELECT"
    else
      native_menu="$(helper_bin browser-picker-menu-select)" || native_menu=""
    fi
  fi

  # Local desktop apps & web apps that match this URL (e.g. T3 Code, Spotify, Zoom, Omarchy web apps).
  if [ -n "$url" ] && [ -n "$apps_bin" ]; then
    while IFS=$'\t' read -r app_lbl app_kind _app_target app_pattern app_scope; do
      [ -n "$app_lbl" ] || continue
      APP_LABELS+=("$app_lbl")
      if [ "$app_kind" = "webapp" ]; then
        WEBAPP_LABELS+=("$app_lbl")
        APP_ORDER_ARGS+=(--webapp "$app_lbl")
      else
        NATIVE_APP_LABELS+=("$app_lbl")
        APP_ORDER_ARGS+=(--app "$app_lbl")
      fi
      if [ -n "$rec_bin" ] && [ -n "$app_pattern" ] && ! resolve "$app_lbl" >/dev/null 2>&1; then
        SUG_PATTERNS+=("$app_pattern")
        SUG_LABELS+=("$app_lbl")
        SUG_PRIVS+=(0)
        SUG_ITEMS+=("⭐  Always open $app_scope in $app_lbl")
      fi
    done < <("$apps_bin" match --url "$url" --with-defaults 2>/dev/null)
  fi

  if [ "${#ENTRIES[@]}" -eq 0 ] && [ "${#APP_LABELS[@]}" -eq 0 ]; then
    notify "No browsers configured — opening setup."
    setsid -f "$(helper_bin browser-picker-rules)" >/dev/null 2>&1
    return 0
  fi
  if [ -z "${BROWSER_PICKER_MENU:-}$native_menu" ] && ! command -v omarchy-launch-walker >/dev/null 2>&1 && ! command -v walker >/dev/null 2>&1; then
    notify "No menu found. Install Walker or configure BROWSER_PICKER_MENU."
    echo "browser-picker: needs Walker, omarchy-menu-select, or BROWSER_PICKER_MENU (see README.md)" >&2
    return 1
  fi

  # Learned-habit shortcuts: if you've picked the same profile or app for this place a couple of
  # times, offer clear one-click defaults. The rule scope is front-loaded so it is visible
  # even in a narrow menu.
  if [ -n "$url" ] && [ -n "$rec_bin" ]; then
    while IFS=$'\t' read -r sug_pattern sug_label sug_priv _sug_scope; do
      [ -n "$sug_pattern" ] || continue
      if resolve "$sug_label" >/dev/null 2>&1; then
        :
      elif is_matched_app "$sug_label"; then
        # Never turn a private habit into a non-private local-app shortcut.
        [ "$sug_priv" = "1" ] && continue
      else
        continue
      fi
      if [ "$sug_priv" = "1" ]; then
        sug_item="⭐  Always open $sug_pattern in $sug_label$PRIV_SUFFIX"
      else
        sug_item="⭐  Always open $sug_pattern in $sug_label"
      fi
      SUG_PATTERNS+=("$sug_pattern")
      SUG_LABELS+=("$sug_label")
      SUG_PRIVS+=("$sug_priv")
      SUG_ITEMS+=("$sug_item")
    done < <("$rec_bin" suggestions --url "$url" 2>/dev/null)
  fi

  # Smart order: matched local apps and profiles you use most (and most for this site) come first.
  if [ -n "$url" ] && [ -n "$rec_bin" ]; then
    smart_out="$("$rec_bin" order --url "$url" "${APP_ORDER_ARGS[@]}" 2>/dev/null)"
    [ -n "$smart_out" ] && mapfile -t SMART <<< "$smart_out"
  fi
  if [ "${#SMART[@]}" -eq 0 ]; then
    for l in "${NATIVE_APP_LABELS[@]}"; do SMART+=("$l"); done
    while IFS= read -r l; do
      [ -n "$l" ] && SMART+=("$l")
    done < <(entry_labels)
    for l in "${WEBAPP_LABELS[@]}"; do SMART+=("$l"); done
  fi

  # Keep one-time destinations together, followed by actions that save a rule.
  MENU_ITEMS=("${SMART[@]}")
  for l in "${SMART[@]}"; do
    resolve "$l" >/dev/null 2>&1 || continue
    private_item="$(unique_menu_item "$l$PRIV_SUFFIX" private)"
    PRIVATE_ITEMS+=("$private_item")
    PRIVATE_TARGETS+=("$l")
    MENU_ITEMS+=("$private_item")
  done
  for i in "${!SUG_ITEMS[@]}"; do
    SUG_ITEMS[i]="$(unique_menu_item "${SUG_ITEMS[i]}" rule)"
    MENU_ITEMS+=("${SUG_ITEMS[i]}")
  done
  [[ "${url,,}" == mailto:* ]] && REMEMBER_LABEL="📌  Create a rule for email links…"
  REMEMBER_LABEL="$(unique_menu_item "$REMEMBER_LABEL" editor)"
  [ -n "$url" ] && MENU_ITEMS+=("$REMEMBER_LABEL")
  EDIT_LABEL="$(unique_menu_item "$EDIT_LABEL" editor)"
  MENU_ITEMS+=("$EDIT_LABEL")

  choice="$(printf '%s\n' "${MENU_ITEMS[@]}" | menu "$(menu_prompt "$url")")" || menu_status=$?
  case "$menu_status" in
    0) ;;
    1) return 0 ;;
    *) notify "Could not open the link picker."; return "$menu_status" ;;
  esac
  [ -z "$choice" ] && return 0
  printf '%s\n' "${MENU_ITEMS[@]}" | grep -Fxq -- "$choice" || return 0

  case "$choice" in
    "$EDIT_LABEL"|"$REMEMBER_LABEL")
      editor_bin="$(helper_bin browser-picker-rules)" || editor_bin=""
      local -a editor_args=()
      [ "$choice" = "$REMEMBER_LABEL" ] && editor_args=("$url")
      if [ -n "$editor_bin" ] && "$editor_bin" "${editor_args[@]}"; then
        return 0
      fi
      notify "Could not open the rules editor. Open the link again to choose a destination."
      return 1 ;;
  esac

  # An "Always open" shortcut saves the rule and opens this link.
  for ((i = 0; i < ${#SUG_ITEMS[@]}; i++)); do
    [ "$choice" = "${SUG_ITEMS[i]}" ] || continue
    sug_pattern="${SUG_PATTERNS[i]}"; sug_label="${SUG_LABELS[i]}"; sug_priv="${SUG_PRIVS[i]}"
    if cmd="$(resolve "$sug_label")"; then
      if [ "$sug_priv" = "1" ]; then
        launch "$cmd $(private_flag "$cmd")" "$@"
        [ -n "$rec_bin" ] && "$rec_bin" addrule --pattern "$sug_pattern" --label "$sug_label" --private 1 >/dev/null 2>&1
        notify "Default set: $sug_pattern → $sug_label (private)"
      else
        launch "$cmd" "$@"
        [ -n "$rec_bin" ] && "$rec_bin" addrule --pattern "$sug_pattern" --label "$sug_label" >/dev/null 2>&1
        notify "Default set: $sug_pattern → $sug_label"
      fi
    elif is_matched_app "$sug_label" && [ -n "$apps_bin" ]; then
      if "$apps_bin" launch --label "$sug_label" --url "$url" >/dev/null 2>&1; then
        [ -n "$rec_bin" ] && "$rec_bin" addrule --pattern "$sug_pattern" --label "$sug_label" >/dev/null 2>&1
        if [[ "$choice" == "⭐  Always open "* ]]; then
          notify "Default saved: ${choice#⭐  Always open }"
        else
          notify "Default set: $sug_pattern → $sug_label"
        fi
        [ "$#" -gt 1 ] && { shift; open_remaining_urls "$@"; }
      else
        notify "Could not open link in $sug_label."
      fi
    fi
    return 0
  done

  # Private-window twin?  "<label>  🕶 Private"
  for ((i = 0; i < ${#PRIVATE_ITEMS[@]}; i++)); do
    [ "$choice" = "${PRIVATE_ITEMS[i]}" ] || continue
    target="${PRIVATE_TARGETS[i]}"
    cmd="$(resolve "$target")" || return 0
    launch "$cmd $(private_flag "$cmd")" "$@"
    # Learn the private habit too (so a private default can be offered).
    [ -n "$url" ] && [ -n "$rec_bin" ] && \
      "$rec_bin" record --url "$url" --label "$target" --private 1 >/dev/null 2>&1
    return 0
  done

  # Matched local desktop app or web app?
  if is_matched_app "$choice" && ! resolve "$choice" >/dev/null 2>&1; then
    if [ -n "$apps_bin" ]; then
      if "$apps_bin" launch --label "$choice" --url "$url" >/dev/null 2>&1; then
        [ -n "$url" ] && [ -n "$rec_bin" ] && \
          "$rec_bin" record --url "$url" --label "$choice" >/dev/null 2>&1
        [ "$#" -gt 1 ] && { shift; open_remaining_urls "$@"; }
      else
        notify "Could not open link in $choice."
      fi
    fi
    return 0
  fi

  cmd="$(resolve "$choice")" || return 0
  launch "$cmd" "$@"

  # Quietly learn this regular-window pick so the picker can offer a default once you repeat it.
  [ -n "$url" ] && [ -n "$rec_bin" ] && \
    "$rec_bin" record --url "$url" --label "$choice" >/dev/null 2>&1
}

# Run main only when executed directly; sourcing (e.g. tests) just loads the functions.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
