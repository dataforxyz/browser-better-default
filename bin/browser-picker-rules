#!/usr/bin/env python3
"""Open the Omarchy Browser Better Default panel."""
import json
from pathlib import Path
import subprocess
import sys
import urllib.parse


def main():
    payload = {}
    if len(sys.argv) == 2:
        url = sys.argv[1]
        try:
            parsed = urllib.parse.urlsplit(url)
            host = parsed.netloc.rsplit("@", 1)[-1].removeprefix("www.")
        except ValueError:
            return 2
        if parsed.scheme in ("http", "https") and host:
            pattern = "/".join([host] + [part for part in parsed.path.split("/") if part][:2])
        elif parsed.scheme == "mailto":
            pattern = "mailto:"
        else:
            return 2
        helper = Path(__file__).resolve().with_name("browser-picker-apps")
        matched = subprocess.run([helper, "match", "--url", url], text=True, capture_output=True)
        label = matched.stdout.partition("\t")[0] if matched.stdout else ""
        payload = {"url": url, "pattern": pattern, "label": label}
    elif len(sys.argv) != 1:
        return 2

    try:
        result = subprocess.run(
            ["omarchy-shell", "shell", "summon", "browser-better-default", json.dumps(payload)],
            text=True, capture_output=True,
        )
    except FileNotFoundError:
        print("Browser Picker settings require Omarchy Quattro.", file=sys.stderr)
        return 1
    if result.returncode or result.stdout.strip() != "ok":
        print("Enable the Browser Better Default plugin to open its rules editor.", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
